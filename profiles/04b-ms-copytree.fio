# P4b — Whole-MS copytree (staging a working copy before in-place modification)
#
# What it models: DSC-008 Step 5b copies the 154 GB MS with shutil.copytree
# before subtracting sources in place; DSC-035's make_toas.sh cp's each .ar
# file; DSC-065's Rucio download+verify is the same shape over the network.
# copytree is sequential file-at-a-time, hence stonewall between the jobs.

[copytree-read-a]
description=Read MS main column
directory=${DIR}
filename=ms_col_a.bin
size=${COLA}G
rw=read
ioengine=psync
bs=4m
iodepth=1

[copytree-read-b]
description=Read MS second column (after the first, like copytree)
directory=${DIR}
filename=ms_col_b.bin
size=${COLB}G
rw=read
ioengine=psync
bs=4m
iodepth=1
stonewall

[copytree-write]
description=Destination of the copy (after the reads)
directory=${DIR}
filename=ms_copy.bin
size=${COLB}G
rw=write
ioengine=psync
bs=4m
iodepth=1
stonewall
