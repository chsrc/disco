# P6 — FITS image chain (blank -> convolve -> average -> cube; PyBDSF slice fan-out)
#
# What it models: the post-imaging transform chains. DSC-065: 40 x 1.07 GB
# channel images read and rewritten through ~4-6 generations (blanked,
# convolved, averaged, cubed) with an 8-process fan-out; DSC-007: 400 x 17 MB
# channel images -> 6.7 GB cube; DSC-043: 4001 channel images -> 262 GB cubes.
# PyBDSF contributes 5 aux images + 2 catalogues per processed slice.
#
# The score runs this profile once (one generation); the real run chains
# ~4-6 of them. 8 parallel workers each process ${NIMG_W} files, so the total file count
# is NIMG_W x 8 (runner sets NIMG_W = NIMG / 8) — mirroring the documented
# "do not try more than 8 processes" cap with per-worker file distribution.

[imagechain-read]
description=Read image generation N (8 workers x NIMG_W files of IMGSZ each)
directory=${DIR}
nrfiles=${NIMG_W}
filesize=${IMGSZ}G
rw=read
ioengine=psync
bs=1m
numjobs=8

[imagechain-write]
description=Write image generation N+1 (new files, same total mass)
directory=${DIR}
nrfiles=${NIMG_W}
filesize=${IMGSZ}G
rw=write
ioengine=psync
bs=1m
numjobs=8
