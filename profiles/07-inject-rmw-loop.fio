# P7 — Injection loop (source-injection read-modify-write x10)
#
# What it models: DSC-057/065 Step 7 source counts: a ~1 GB residual FITS is
# loaded, 1000 Gaussians injected, the FULL-size image is written to
# <residual>.fake.fits, PyBDSF runs on it, and this repeats 10 times
# (measured: "roughly two hours on the full AA2 data").
#
# rw=rw interleaves sequential reads and writes on the same file; loops=10
# replays the injection iterations.

[injection-rmw]
description=Read-modify-write a full-size image, 10 iterations
directory=${DIR}
filename=imagechain-read.0.0
rw=rw
rwmixread=50
rwmixwrite=50
ioengine=psync
bs=1m
loops=10
iodepth=1
