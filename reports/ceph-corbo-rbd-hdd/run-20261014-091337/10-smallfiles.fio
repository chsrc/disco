# P10 — Small-file / metadata storm (plot + catalogue fan-out)
#
# What it models: the output tail of the workflows:
#   png-storm    : one PNG/PDF per source/timestep written serially (DSC-057:
#                  12,078 per-source PDFs; DSC-053: one PNG per timestep)
#   catalogues   : MB-scale FITS tables + catalogues (cross-match outputs)
# Filesize spread is the small-file metadata load (dentry/inode pressure).

[png-storm]
description=Fan-out of many small files (plots per source/timestep)
directory=/data/bench/run-20261014-091337
nrfiles=2000
filesize=128k
rw=write
ioengine=psync
bs=64k

[catalogues]
description=MB-scale catalogue writes
directory=/data/bench/run-20261014-091337
nrfiles=40
filesize=8m
rw=write
ioengine=psync
bs=1m
