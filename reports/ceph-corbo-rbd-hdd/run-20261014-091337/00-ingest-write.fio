# P9 — Staging / ingest (Rucio download to .part + checksum verify)
#
# What it models: data staging onto the node: Rucio client streams a large
# file over HTTP to a <dest>.part at network rate (measured single-stream
# 237-250 MiB/s for ~10 TB files; 13-24 MB/s per stream SWE<->JP; 15-17 Gb/s
# aggregate at ~25-way concurrency), then re-reads the whole file to verify
# the checksum. bs=64k approximates the effective write granularity of the
# buffered HTTP stream.

[staging-write]
description=Network-rate sequential write of a staged dataset
directory=/data/bench/run-20261014-091337
filename=ms_col_a.staged
size=96G
rw=write
ioengine=psync
bs=64k
rate=6250m
iodepth=1
