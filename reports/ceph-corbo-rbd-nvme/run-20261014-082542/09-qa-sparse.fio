# P11 — Sparse QA access (single-baseline casacore TaQL reads / plot_ms)
#
# What it models: QA notebooks that select ONE baseline out of thousands and
# read a few columns (DATA/FLAG/TIME/WEIGHT_SPECTRUM) in 100k-row chunks,
# touching <1% of the MS with repeated column seeks; also shadems-style
# decimated full-column reads (ROWNUMBER()%60). Low volume, small blocks,
# scattered offsets — the latency-sensitive random tail of the workloads.

[qa-sparse]
description=Random small reads over the MS main column file (<1% of volume)
directory=/data/bench/run-20261014-082542
filename=ms_col_a.bin
rw=randread
ioengine=psync
bs=8k
size=2G
iodepth=1
lat_percentiles=1
